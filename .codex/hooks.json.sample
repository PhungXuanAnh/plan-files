{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "statusMessage": "Checking planning ownership",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ROOT=\"$(bash \"$ROOT/skills/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/pre-tool-use.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ROOT=\"$(bash \"$ROOT/skills/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/user-prompt-submit.sh\"",
            "timeout": 5,
            "statusMessage": "Checking planning scope"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ROOT=\"$(bash \"$ROOT/skills/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/post-tool-use.sh\"",
            "timeout": 5,
            "statusMessage": "Injecting planning context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ROOT=\"$(bash \"$ROOT/skills/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/agent-stop.sh\"",
            "timeout": 10,
            "statusMessage": "Checking planning completion"
          }
        ]
      }
    ]
  }
}
