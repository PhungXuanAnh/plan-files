{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/post-tool-use.sh\"",
            "timeout": 5,
            "statusMessage": "Injecting planning context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && cd \"$ROOT\" && bash \"$ROOT/.codex/hooks/planning-with-files/scripts/agent-stop.sh\"",
            "timeout": 10,
            "statusMessage": "Checking planning completion"
          }
        ]
      }
    ]
  }
}
