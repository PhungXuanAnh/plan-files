{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "/home/xuananh/repo/planning-with-files/.github/hooks/scripts/pre-tool-use.sh",
        "timeout": 5
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "/home/xuananh/repo/planning-with-files/.github/hooks/scripts/user-prompt-transformed.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "/home/xuananh/repo/planning-with-files/.github/hooks/scripts/post-tool-use.sh",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "/home/xuananh/repo/planning-with-files/.github/hooks/scripts/agent-stop.sh",
        "timeout": 10
      }
    ],
    "ErrorOccurred": [
      {
        "type": "command",
        "bash": "/home/xuananh/repo/planning-with-files/.github/hooks/scripts/error-occurred.sh",
        "timeout": 5
      }
    ]
  }
}
