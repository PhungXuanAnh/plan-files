{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(bash \"$HOME/.claude/hooks/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$HOME/.claude/hooks/planning-with-files/scripts/pre-tool-use.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(bash \"$HOME/.claude/hooks/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$HOME/.claude/hooks/planning-with-files/scripts/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(bash \"$HOME/.claude/hooks/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$HOME/.claude/hooks/planning-with-files/scripts/user-prompt-submit.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(bash \"$HOME/.claude/hooks/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$HOME/.claude/hooks/planning-with-files/scripts/post-tool-use.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(bash \"$HOME/.claude/hooks/planning-with-files/scripts/resolve-project-root.sh\")\" && cd \"$ROOT\" && bash \"$HOME/.claude/hooks/planning-with-files/scripts/agent-stop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
